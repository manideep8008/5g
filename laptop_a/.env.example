# ─── Network A (Laptop A): collector + behavioural-summary API ──────────────
# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ibn_zta
POSTGRES_USER=ibn_zta
POSTGRES_PASSWORD=changeme_in_production

# Identity + request signing — MUST be byte-identical to Laptop B.
# Shared secret for both UE pseudonym derivation and the A↔B HMAC signing layer.
HMAC_SECRET_KEY=changeme_replace_with_random_hex_64

# Enforce HMAC signatures on the cross-network summary channel (zero-trust).
# Default ON — fail closed. Set to false only for a controlled rollout.
REQUIRE_SIGNED_REQUESTS=true

# This API
NETWORK_A_HOST=0.0.0.0
NETWORK_A_PORT=8001

# OAI CN5G inputs
AMF_LOG_PATH=data/logs/amf_live.log
UPF_PROMETHEUS_URL=http://localhost:9090/metrics
