# ─── Postgres (IBN-ZTA database) ────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ibn_zta
POSTGRES_USER=ibn_zta
POSTGRES_PASSWORD=changeme_in_production

# ─── Redis ──────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Identity ──────────────────────────────────────────────────
# IMPORTANT: when running two physical 5G cores (Network A + Network B
# for the roaming demo), HMAC_SECRET_KEY MUST be identical on both hosts.
# Both networks derive UE pseudonyms as HMAC-SHA256(IMSI, HMAC_SECRET_KEY);
# they only agree on "this is the same UE" if the secret matches.
HMAC_SECRET_KEY=changeme_replace_with_random_hex_64

# ─── Network A / B FastAPIs ─────────────────────────────────────
NETWORK_A_HOST=localhost
NETWORK_A_PORT=8001
NETWORK_B_HOST=localhost
NETWORK_B_PORT=8002
NETWORK_A_URL=http://localhost:8001

# ─── OAI CN5G Integration ──────────────────────────────────────
# AMF logs: captured from Docker via scripts/start_with_oai.sh
AMF_LOG_PATH=data/logs/amf_live.log

# UPF Prometheus metrics (port 9090 forwarded from oai-upf container)
# Requires metrics enabled in conf/config.yaml:
#   register_nf: general: metrics: { enabled: true, port: 9090 }
UPF_PROMETHEUS_URL=http://localhost:9090/metrics

# ─── Roaming demo: Network B side ──────────────────────────────
# Used by network_b.collector.attachment_watcher when running on the
# Network B host. Points at the second OAI CN5G's AMF log and at
# Network B's own decision API.
#   AMF_LOG_PATH=data/logs/netb-amf.log
#   NETWORK_B_URL=http://localhost:8002
#   REQUESTED_SLICE=eMBB
#   REQUESTED_DNN=internet
#   REQUESTED_SERVICE=standard_data

# ─── LLM (Ollama) ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gpt-oss:120b-cloud
LLM_TEMPERATURE=0.0
