# ─── Network B (Laptop B): decision + policy + RAG API ──────────────────────
# Identity + request signing — MUST be byte-identical to Laptop A.
# Shared secret for both UE pseudonym derivation and the A↔B HMAC signing layer.
HMAC_SECRET_KEY=changeme_replace_with_random_hex_64

# Enforce HMAC signatures on the cross-network summary channel (zero-trust).
# Default ON — fail closed. Network B drops the UE to T1 if Network A's
# response signature is missing or invalid. Set false only for rollout.
REQUIRE_SIGNED_REQUESTS=true

# This API
NETWORK_B_HOST=0.0.0.0
NETWORK_B_PORT=8002

# Network A summary API — set to Laptop A's LAN address.
NETWORK_A_URL=http://LAPTOP_A_IP:8001

# Network B's own OAI CN5G AMF log + access request defaults
AMF_LOG_PATH=data/logs/netb-amf.log
NETWORK_B_URL=http://localhost:8002
REQUESTED_SLICE=eMBB
REQUESTED_DNN=internet
REQUESTED_SERVICE=standard_data

# LLM (Ollama) + RAG store
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gpt-oss:120b-cloud
LLM_TEMPERATURE=0.0
RAG_STORE_PATH=data/knowledge_base/index
